# Docker Compose Project Configuration
COMPOSE_PROJECT_NAME=manhq

# URL do backend (obrigatório)
# Usado pelo Next.js para proxy de /api/*
API_URL=https://api.manhq.com.br

# URL pública do frontend (usada em metadata/canonical/PWA)
NEXT_PUBLIC_SITE_URL=https://app.seudominio.com

# Traefik Configuration (Hostinger Docker Manager)
# Domínio onde o frontend será exposto através do Traefik
# Exemplo: app.seudominio.com ou seudominio.com
TRAEFIK_HOST=app.seudominio.com

# Origin of the S3 bucket used for presigned video uploads (bypasses Cloudflare body limit).
# Must match exactly: https://<bucket>.s3.<region>.amazonaws.com
# Required when S3_BUCKET is set on the backend.
S3_UPLOAD_ORIGIN=https://my-bucket.s3.sa-east-1.amazonaws.com
